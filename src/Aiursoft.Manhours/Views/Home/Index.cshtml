<div class="container py-4">
    <h1 class="h3 mb-3">@Localizer["Manhours"]</h1>

    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["Badge Generator"]</h5>
                    <small class="text-muted d-block">
                        @Localizer["Enter the clone url of your git repository to generate a badge for your project."]
                    </small>
                </div>
                <div class="card-body">
                    <form method="post" id="manhours-form">
                        <div class="mb-3">
                            <label for="cloneUrl" class="form-label">
                                <i class="fa-brands fa-git-alt"></i>
                                @Localizer["HTTP Clone URL"]
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="cloneUrl"
                                   name="cloneUrl"
                                   placeholder="https://github.com/aiursoftweb/manhours.git" />
                        </div>

                        <div class="form-check mt-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="directMode"
                                   name="directMode" />
                            <label class="form-check-label" for="directMode">
                                @Localizer["Direct mode (Without proxy from img.shields.io)"]
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary mt-3">@Localizer["Generate"]</button>

                        <div class="mt-4 d-none" id="result">
                            <label for="preview" class="form-label">@Localizer["Preview"]</label>
                            <div class="mb-3" id="preview">
                                <span id="loading-icon" class="d-none" role="status">
                                    <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
                                    @Localizer["Loading preview..."]
                                </span>
                                <a id="preview-link" href="#" target="_blank">
                                    <img alt="@Localizer["Man hours icon"]"
                                         id="preview-img"
                                         class="img-fluid d-none" />
                                </a>
                            </div>

                            <p id="preview-error" class="text-danger d-none" role="alert">
                                @Localizer["Preview could not be loaded. Select Generate to try again. You can still copy the code below."]
                            </p>

                            <label for="markdown" class="form-label mt-2">@Localizer["Markdown"]</label>
                            <textarea id="markdown" class="form-control" rows="3" readonly></textarea>

                            <label for="html" class="form-label mt-3">@Localizer["HTML"]</label>
                            <textarea id="html" class="form-control" rows="3" readonly></textarea>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="badge-generator-data" data-origin="@Context.Request.Scheme://@Context.Request.Host" hidden>
    <span data-key="empty-url">@Localizer["Please input the clone url!"]</span>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section Scripts {
    <script src="~/scripts/badge-generator.js" asp-append-version="true"></script>
}
